# Copy this content into the GitHub secret named DEPLOY_ENV_FILE for server deployment.
# Do not commit the real production .env file.

DOCKER_FRONTEND_PORT=80
DOCKER_BACKEND_PORT=8000

DOCKER_MYSQL_ROOT_PASSWORD=change-this-root-password
DOCKER_MYSQL_DATABASE=ai_testcase
DOCKER_MYSQL_USER=ai_test_user
DOCKER_MYSQL_PASSWORD=change-this-db-password

AUTH_SECRET_KEY=change-this-to-a-long-random-production-secret
AUTH_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_SECURE=false
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-this-admin-password
APP_ADMIN_DISPLAY_NAME=管理员

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=5000
API_DOC_LLM_ENHANCE=true
API_DOC_DEFAULT_BASE_URL=http://127.0.0.1:8080

# Keep false on a public server unless you intentionally need to test server-local addresses.
API_RUNNER_ALLOW_LOCALHOST=false

# Keep false on a public server unless you intentionally need to parse private docs.
WEB_DOC_MAX_LINKS=5
WEB_DOC_MAX_PAGES=8
WEB_DOC_MAX_BYTES=2097152
WEB_DOC_MAX_CONTENT_CHARS=24000
WEB_DOC_TIMEOUT_SECONDS=20
WEB_DOC_ALLOW_PRIVATE=false

# Redis cache, task queue, rate limit and distributed lock settings.
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=ai-test-prod
TASK_QUEUE_ENABLED=true
TASK_WORKER_CONCURRENCY=2
TASK_SUBMIT_RATE_LIMIT=30
TASK_SUBMIT_RATE_WINDOW_SECONDS=60
TASK_RESULT_TTL_SECONDS=86400
