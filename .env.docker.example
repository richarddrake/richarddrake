# 这个模板文件负责说明 Docker Compose 演示环境可覆盖的端口、数据库和模型变量。
# 可选：复制为 .env.docker 后配合 scripts/docker-start.cmd 使用。

# Host ports. MySQL defaults to 3307 to avoid conflicting with a local MySQL on 3306.
DOCKER_FRONTEND_PORT=5173
DOCKER_BACKEND_PORT=8000
DOCKER_MYSQL_PORT=3307
DOCKER_REDIS_PORT=6379

# MySQL container credentials.
DOCKER_MYSQL_ROOT_PASSWORD=ai_test_root
DOCKER_MYSQL_DATABASE=ai_testcase
DOCKER_MYSQL_USER=ai_test_user
DOCKER_MYSQL_PASSWORD=ai_test_password

# Login and permission system.
AUTH_SECRET_KEY=change-this-to-a-long-random-secret
AUTH_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_SECURE=false
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=Admin@123456
APP_ADMIN_DISPLAY_NAME=管理员

# Optional LLM settings. Leave OPENAI_API_KEY empty to use the local demo generator.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=5000
API_DOC_LLM_ENHANCE=true
API_DOC_DEFAULT_BASE_URL=http://127.0.0.1:8080

# Optional public web document reading for HTML/JSON API documents.
WEB_DOC_MAX_LINKS=5
WEB_DOC_MAX_PAGES=8
WEB_DOC_MAX_BYTES=2097152
WEB_DOC_MAX_CONTENT_CHARS=24000
WEB_DOC_TIMEOUT_SECONDS=20
WEB_DOC_ALLOW_PRIVATE=false

# Redis cache, task queue, rate limit and distributed lock settings.
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=ai-test
TASK_QUEUE_ENABLED=true
TASK_WORKER_CONCURRENCY=2
TASK_SUBMIT_RATE_LIMIT=30
TASK_SUBMIT_RATE_WINDOW_SECONDS=60
TASK_RESULT_TTL_SECONDS=86400
