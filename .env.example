# 这个模板文件负责说明后端模型、数据库和运行环境变量的默认配置方式。
# Copy this file to .env, then fill in your real model settings.
# Do not commit .env to GitHub.

# Required: your API key.
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI official endpoint:
OPENAI_BASE_URL=https://api.openai.com/v1

# Use a model that supports image input and Chat Completions streaming.
OPENAI_MODEL=gpt-4o-mini

# Optional tuning.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=5000

# Optional Feishu / Lark private document reading.
# Create an internal app in Feishu Open Platform, grant document/wiki read permissions,
# and share the target private document with the app or its available scope.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_READ_TIMEOUT_SECONDS=20
FEISHU_MAX_CONTENT_CHARS=12000

# MySQL history storage.
# Create the database first, then set DATABASE_ENABLED=true.
DATABASE_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_test_user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=ai_testcase
MYSQL_CHARSET=utf8mb4

# Optional override. If provided, DATABASE_URL takes precedence over MYSQL_* fields.
# DATABASE_URL=mysql+pymysql://ai_test_user:your-mysql-password@127.0.0.1:3306/ai_testcase?charset=utf8mb4
